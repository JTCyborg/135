{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "P135_BUILD_TESTS": "ON",
        "P135_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "vs2026-desktop-debug",
      "displayName": "Project135 — Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vs2026-desktop-release",
      "displayName": "Project135 — Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-desktop-debug",
      "displayName": "Build Project135 — Debug",
      "configurePreset": "vs2026-desktop-debug",
      "configuration": "Debug"
    },
    {
      "name": "build-desktop-release",
      "displayName": "Build Project135 — Release",
      "configurePreset": "vs2026-desktop-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test-desktop-debug",
      "displayName": "Test Project135 — Debug",
      "configurePreset": "vs2026-desktop-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-desktop-release",
      "displayName": "Test Project135 — Release",
      "configurePreset": "vs2026-desktop-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
