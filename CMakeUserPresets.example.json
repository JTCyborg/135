{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-desktop-debug-local",
      "displayName": "VS 2026 x64 Debug — Desktop",
      "inherits": "vs2026-desktop-debug"
    },
    {
      "name": "vs2026-desktop-release-local",
      "displayName": "VS 2026 x64 Release — Desktop",
      "inherits": "vs2026-desktop-release"
    }
  ],
  "buildPresets": [
    {
      "name": "build-desktop-debug-local",
      "displayName": "Build Desktop Debug",
      "configurePreset": "vs2026-desktop-debug-local",
      "configuration": "Debug"
    },
    {
      "name": "build-desktop-release-local",
      "displayName": "Build Desktop Release",
      "configurePreset": "vs2026-desktop-release-local",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "test-desktop-debug-local",
      "displayName": "Test Desktop Debug",
      "configurePreset": "vs2026-desktop-debug-local",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-desktop-release-local",
      "displayName": "Test Desktop Release",
      "configurePreset": "vs2026-desktop-release-local",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
